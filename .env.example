# Copy to .env and fill in. Never commit .env.
# Unquoted KEY=value lines only — kubectl --from-env-file keeps quotes as part of the value.

# Required for LKE image build/push (docker must be logged in to this registry).
# Examples:
#   IMAGE_REGISTRY=ghcr.io/your-user/hackmidwest-2026
#   IMAGE_REGISTRY=registry.linode.com/your-namespace
# Use lowercase for the GHCR owner path (Docker requires lowercase repository names).
IMAGE_REGISTRY=

# Optional inference / app settings (loaded into api + agents pods as Secret app-env).
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=
CHAT_MODEL=hackathon-chat
EMBEDDING_MODEL=hackathon-embedding

# Managed PostgreSQL. scripts/deploy_lke.sh creates/reuses label hackmidwest-db in
# REGION (us-central) and writes this URL (sslmode=require). Leave empty to let
# deploy fill it; or set SKIP_DB=1 to reuse an existing value without provisioning.
DATABASE_URL=

# Service discovery (local defaults). On LKE, Deployments override these to
# http://api:8000 and http://agents:8000.
API_URL=http://127.0.0.1:8000
AGENTS_URL=http://127.0.0.1:8001

# Comma-separated browser origins allowed by the API/agents (local Next.js default).
CORS_ORIGINS=http://localhost:3000
