# Copy to .env and fill in. Never commit .env.
# Unquoted KEY=value lines only — kubectl --from-env-file keeps quotes as part of the value.

# Required for LKE image build/push (docker must be logged in to this registry).
# Examples:
#   IMAGE_REGISTRY=ghcr.io/your-user/hackmidwest-2026
#   IMAGE_REGISTRY=registry.linode.com/your-namespace
# Use lowercase for the GHCR owner path (Docker requires lowercase repository names).
IMAGE_REGISTRY=

# Inference settings go only to agents; pod env selects required Secret keys.
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=
CHAT_MODEL=hackathon-chat
EMBEDDING_MODEL=hackathon-embedding

# Managed PostgreSQL. scripts/deploy_lke.sh creates/reuses label hackmidwest-db in
# REGION (us-central) and writes this URL (sslmode=require). Leave empty to let
# deploy fill it; or set SKIP_DB=1 to reuse an existing value without provisioning.
DATABASE_URL=

# Required for signup/signin JWT minting (set a long random string in .env).
JWT_SECRET=
# Optional JWT lifetime in minutes (default 7 days).
JWT_EXPIRE_MINUTES=10080

# R02 mandate Ed25519 seed: base64-encoded 32 bytes (not a passphrase).
# Generate: python -c 'import os,base64; print(base64.b64encode(os.urandom(32)).decode())'
MANDATE_SIGNING_KEY=

# Optional demo human bearer (min 32 chars, distinct from agent tokens) + LEASH user id.
# USER_TOKEN=
# DEMO_USER_ID=usr_demo

# Signup creates identity only and never calls Lithic. These keys support legacy
# sandbox metadata/balance reads; future issuance requires a verified purchase.
# Production/custom provider endpoints are rejected. Never commit a real key.
LITHIC_API_KEY=
LITHIC_ENVIRONMENT=sandbox
# Legacy internal wrapper setting; signup never uses this limit.
LITHIC_DEFAULT_SPEND_LIMIT_CENTS=50000
LITHIC_ASA_SECRET=

# Service discovery (local defaults). On LKE, Deployments override these to
# http://api:8000 and http://agents:8000.
API_URL=http://127.0.0.1:8000
AGENTS_URL=http://127.0.0.1:8001

# MCP Streamable HTTP endpoints (path /mcp). In-cluster agents use k8s/agents.yaml
# overrides. Public MCP proxies are disabled by default; local debugging may opt in:
#   http://<NB_IP>/mcp-leash/mcp
#   http://<NB_IP>/mcp-store/mcp
# Local direct (no Next proxy):
MCP_LEASH_URL=http://127.0.0.1:8002/mcp
MCP_STORE_URL=http://127.0.0.1:8003/mcp
# Local Next proxy origins (when running `pnpm dev` and hitting localhost:3000/mcp-*).
# MCP_LEASH_ORIGIN=http://127.0.0.1:8002
# MCP_STORE_ORIGIN=http://127.0.0.1:8003
# Controlled-merchant HTTP API (Cameron's store service). mcp-store browses/calls this.
# Local default port 8004. On LKE, k8s/mcp-store.yaml overrides to http://store:8000.
STORE_URL=http://127.0.0.1:8004
# Optional comma-separated public aliases that map onto STORE_URL (browse allowlist).
# Include every host the shopper might see in page links / start URLs.
STORE_PUBLIC_URLS=http://127.0.0.1:8004,http://localhost:8004

# Comma-separated browser origins allowed by the API/agents (local Next.js default).
# On LKE, include the NodeBalancer origin, e.g. http://173.255.199.245
CORS_ORIGINS=http://localhost:3000,http://173.255.199.245

# Agents/MCP auth. Any long random string each (openssl rand -hex 32).
# Bind on the API with manage.py (live vs scripted are separate agents/modes).
# These are not card authority; POST /cards always rejects direct issuance.
AGENTS_SERVICE_TOKEN=
AGENT_TOKEN_SHOPPER=
AGENT_TOKEN_SHOPPER_SCRIPTED=

# Bearer required by mcp-store callers (generate: openssl rand -hex 32).
STORE_MCP_TOKEN=
# Optional credential mcp-store sends to the store HTTP API (when store enforces it).
STORE_API_TOKEN=

# Payment rail (services/webhook). Valkey holds grants / event idempotency / kill switch.
# Valkey is required by default. Explicit isolated development may set ALLOW_MEMORY_RAIL=1;
# never use that override on LKE. Valkey deployment persists AOF and idempotency tombstones.
VALKEY_URL=redis://127.0.0.1:6379/0
# On LKE, k8s/webhook.yaml overrides VALKEY_URL to redis://valkey:6379/0.
WEBHOOK_URL=http://127.0.0.1:8005
# API-only bearer for /internal/* (generate a distinct value of at least 32 chars).
WEBHOOK_INTERNAL_TOKEN=
# Merchant-only bearer for /local/authorize; never the API control token.
WEBHOOK_CHARGE_TOKEN=
# Optional local debugging only: public MCP rewrites are disabled by default.
# ENABLE_PUBLIC_MCP_PROXY=1
# Snapshot variables used by Store MCP; replace with workshop values.
OBJ_ENDPOINT=
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=

# Dedicated event-only publisher credential (API and webhook, at least 32 chars).
RAIL_EVENT_TOKEN=
# ASA rejects all requests until this secret is configured; HTTPS responder required.
# Retrieve /v1/auth_stream/secret after sandbox enrollment. No production rail.
# Public endpoint: https://<YOUR_TLS_HOST>/rail/lithic/asa
# RAIL_ORIGIN=http://127.0.0.1:8005

# Explicit operator enrollment target; must be an exact HTTPS URL.
LITHIC_ASA_RESPONDER_URL=
