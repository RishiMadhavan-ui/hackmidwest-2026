# Root build context for api/ and agents/ Dockerfiles (docker build -f … .).
# web/ and mcp-* images use their own directory as context and ignore this file.
.git
.github
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.next
**/node_modules
.env
.env.*
!.env.example
hackmidwest-kubeconfig.yaml
*.md
web
services/mcp
services/mcp-leash
services/mcp-store
# store + webhook images build from repo root (need services/* + shared/).
services/store/**/__pycache__
services/store/.venv
services/store/tests
services/webhook/**/__pycache__
services/webhook/.venv
services/webhook/tests
tests
docs
infra
.idea
.cursor